diff --git a/include/comm/k_sensor_sc038hgs.h b/include/comm/k_sensor_sc038hgs.h
new file mode 100644
index 0000000..76404ec
--- /dev/null
+++ b/include/comm/k_sensor_sc038hgs.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef K_SENSOR_SC038HGS_H
+#define K_SENSOR_SC038HGS_H
+
+/* SC038HGS V1.1, tables 2-12 and 2-13. EXTCLK is NOT Pixel CLK. */
+#define SC038HGS_WIDTH       640U
+#define SC038HGS_HEIGHT      480U
+#define SC038HGS_HTS         750U
+#define SC038HGS_VTS         600U
+#define SC038HGS_MAX_VTS     0xfff0U
+#ifndef CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ
+#define CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ 0
+#endif
+#define SC038HGS_DEFAULT_FPS_MILLI \
+    ((k_u32)((k_u64)CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ * 1000U / \
+             (SC038HGS_HTS * SC038HGS_VTS)))
+
+#endif
diff --git a/kernel/sensor/src/sc038hgs/sc038hgs.c b/kernel/sensor/src/sc038hgs/sc038hgs.c
new file mode 100644
index 0000000..d973cdf
--- /dev/null
+++ b/kernel/sensor/src/sc038hgs/sc038hgs.c
@@ -0,0 +1,748 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "sensor_dev.h"
+#include "drv_gpio.h"
+#include "k_sensor_sc038hgs.h"
+#include <float.h>
+
+#define SC038HGS_CHIP_ID 0x1a79U
+#define SC038HGS_MIN_EXP_LINES 4U
+#define SC038HGS_EXP_MARGIN 11U
+#define SC038HGS_INITIAL_EXP (128U * 16U)
+
+#include "sensor_reg_table.c"
+
+static k_sensor_ae_info sc038hgs_ae_defaults = {
+    .frame_length = SC038HGS_VTS,
+    .cur_frame_length = SC038HGS_VTS,
+    .gain_accuracy = 1024,
+    .min_gain = 1.0f,
+    .max_gain = 39.375f * 7.875f,
+    .gain_increment = 1.0f / 32.0f,
+    .max_integraion_line = SC038HGS_VTS - SC038HGS_EXP_MARGIN,
+    .min_integraion_line = SC038HGS_MIN_EXP_LINES,
+    .cur_again = 1.0f, .cur_dgain = 1.0f, .cur_gain = 1.0f,
+    .gain = {1.0f, 39.375f * 7.875f, 1.0f / 32.0f},
+    .a_gain = {1.0f, 39.375f, 1.0f / 32.0f},
+    .d_gain = {1.0f, 7.875f, 1.0f / 32.0f},
+    .int_time_delay_frame = 2,
+    .gain_delay_frame = 2,
+#ifdef CONFIG_MPP_SC038HGS_MONO
+    .color_type = SENSOR_MONO,
+#else
+    .color_type = SENSOR_COLOR,
+#endif
+};
+
+#define SC038HGS_MODE(n) { \
+    .index = 0, \
+    .sensor_type = SC038HGS_MIPI_CSI##n##_640X480_10BIT_LINEAR, \
+    .size = {.bounds_width = 640, .bounds_height = 480, .width = 640, .height = 480}, \
+    .fps = SC038HGS_DEFAULT_FPS_MILLI, \
+    .hdr_mode = SENSOR_MODE_LINEAR, .bit_width = 10, \
+    .bayer_pattern = BAYER_PAT_BGGR, \
+    .mipi_info = {.csi_id = n, .mipi_lanes = 1, .data_type = 0x2b}, \
+    .reg_list = sc038hgs_default_regs, \
+    .sensor_ae_info = &sc038hgs_ae_defaults, \
+}
+
+static const k_sensor_mode sc038hgs_modes[] = {
+#ifdef CONFIG_MPP_ENABLE_CSI_DEV_0
+    SC038HGS_MODE(0),
+#endif
+#ifdef CONFIG_MPP_ENABLE_CSI_DEV_1
+    SC038HGS_MODE(1),
+#endif
+#ifdef CONFIG_MPP_ENABLE_CSI_DEV_2
+    SC038HGS_MODE(2),
+#endif
+};
+
+static k_s32 sc038hgs_update_bits(struct sensor_driver_dev *dev, k_u16 addr,
+                                k_u16 mask, k_u16 value)
+{
+    k_u16 old;
+    k_s32 ret = sensor_reg_read(&dev->i2c_info, addr, &old);
+    if (ret)
+        return ret;
+    return sensor_reg_write(&dev->i2c_info, addr, (old & ~mask) | (value & mask));
+}
+
+static k_s32 sc038hgs_read16(struct sensor_driver_dev *dev, k_u16 addr, k_u32 *value)
+{
+    k_u16 hi, lo;
+    k_s32 ret = sensor_reg_read(&dev->i2c_info, addr, &hi);
+    if (!ret)
+        ret = sensor_reg_read(&dev->i2c_info, addr + 1, &lo);
+    if (!ret)
+        *value = (hi << 8) | lo;
+    return ret;
+}
+
+/* Group 0 holds up to eight registers by default (datasheet p. 29). */
+static k_s32 sc038hgs_group_write(struct sensor_driver_dev *dev,
+                                const k_sensor_reg *regs, k_u32 count)
+{
+    k_s32 ret, end_ret;
+    if (count > 8)
+        return -EINVAL;
+    ret = sensor_reg_write(&dev->i2c_info, 0x3800, 0x00);
+    if (ret) {
+        /* A failed transfer may still have reached the sensor. */
+        dev->mode_init_flag = K_FALSE;
+        dev->init_flag = K_FALSE;
+        return ret;
+    }
+    for (k_u32 i = 0; i < count; ++i) {
+        ret = sensor_reg_write(&dev->i2c_info, regs[i].addr, regs[i].val);
+        if (ret)
+            break;
+    }
+    end_ret = sensor_reg_write(&dev->i2c_info, 0x3800, 0x10);
+    if (ret || end_ret) {
+        /* Never launch an incomplete group; require initialization again. */
+        dev->mode_init_flag = K_FALSE;
+        dev->init_flag = K_FALSE;
+        return ret ? ret : end_ret;
+    }
+    ret = sensor_reg_write(&dev->i2c_info, 0x3800, 0x60);
+    if (ret) {
+        dev->mode_init_flag = K_FALSE;
+        dev->init_flag = K_FALSE;
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_gpio(k_s32 pin, k_s32 value)
+{
+    k_s32 ret;
+    if (pin < 0)
+        return 0;
+    ret = kd_pin_mode(pin, GPIO_DM_OUTPUT);
+    return ret ? ret : kd_pin_write(pin, value);
+}
+
+static k_s32 sc038hgs_power(void *ctx, k_s32 on)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_s32 ret = 0, gpio_ret;
+    if (on && dev->power_flag)
+        return 0;
+    dev->init_flag = K_FALSE;
+    dev->mode_init_flag = K_FALSE;
+    if (on) {
+        ret = sc038hgs_gpio(dev->reset_gpio, GPIO_PV_LOW);
+        if (!ret)
+            ret = sc038hgs_gpio(dev->pwd_gpio, GPIO_PV_LOW);
+        if (ret)
+            return ret;
+        rt_thread_mdelay(5);
+        ret = sc038hgs_gpio(dev->pwd_gpio, GPIO_PV_HIGH);
+        if (!ret)
+            ret = sc038hgs_gpio(dev->reset_gpio, GPIO_PV_HIGH);
+        if (ret) {
+            (void)sc038hgs_gpio(dev->pwd_gpio, GPIO_PV_LOW);
+            return ret;
+        }
+        /* XSHUTDN/PWDN low = shutdown. T4 >= 4 ms (p. 8). */
+        rt_thread_mdelay(20);
+        dev->power_flag = K_TRUE;
+        return 0;
+    }
+    if (dev->power_flag) {
+        ret = sc038hgs_update_bits(dev, 0x2100, 0x01, 0);
+        rt_thread_mdelay(1); /* >= 6 EXTCLK periods before shutdown (p. 9). */
+    }
+    gpio_ret = sc038hgs_gpio(dev->reset_gpio, GPIO_PV_LOW);
+    if (!ret)
+        ret = gpio_ret;
+    gpio_ret = sc038hgs_gpio(dev->pwd_gpio, GPIO_PV_LOW);
+    if (!ret)
+        ret = gpio_ret;
+    dev->power_flag = K_FALSE;
+    return ret;
+}
+
+static k_s32 sc038hgs_get_id(void *ctx, k_u32 *id)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_s32 ret;
+    if (!id)
+        return -EINVAL;
+    *id = 0;
+    if (!dev->power_flag)
+        return -EIO;
+    ret = sc038hgs_read16(dev, 0x3107, id);
+    return ret ? ret : (*id == SC038HGS_CHIP_ID ? 0 : -ENODEV);
+}
+
+static void sc038hgs_timing(struct sensor_driver_dev *dev, k_u32 hts, k_u32 vts)
+{
+    k_sensor_mode *mode = &dev->current_sensor_mode;
+    k_sensor_ae_info *ae = &mode->ae_info;
+    const k_u32 pclk = CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ;
+    ae->frame_length = vts;
+    ae->cur_frame_length = vts;
+    ae->max_integraion_line = vts - SC038HGS_EXP_MARGIN;
+    ae->one_line_exp_time = pclk ? (float)hts / pclk : 0.0f;
+    ae->integration_time_increment = ae->one_line_exp_time / 16.0f;
+    ae->min_integraion_time = ae->one_line_exp_time * SC038HGS_MIN_EXP_LINES;
+    ae->max_integraion_time = ae->one_line_exp_time * ae->max_integraion_line;
+    ae->max_fps = SC038HGS_DEFAULT_FPS_MILLI;
+    ae->min_fps = pclk ? (k_u64)pclk * 1000U / (hts * SC038HGS_MAX_VTS) : 0;
+    ae->cur_fps = pclk ? (k_u64)pclk * 1000U / (hts * vts) : 0;
+    mode->fps = ae->cur_fps;
+}
+
+static k_s32 sc038hgs_get_mode(void *ctx, k_sensor_mode *mode)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (!mode || mode->sensor_type != dev->sensor_mode_list[0].sensor_type)
+        return -EINVAL;
+    *mode = dev->current_sensor_mode;
+    return 0;
+}
+
+static k_s32 sc038hgs_mirror(void *ctx, k_vicap_mirror_mode mirror)
+{
+    struct sensor_driver_dev *dev = ctx;
+    static const k_u8 bits[] = {0, 0x06, 0x60, 0x66};
+    static const k_sensor_bayer_pattern patterns[] = {
+        BAYER_PAT_BGGR, BAYER_PAT_GBRG, BAYER_PAT_GRBG, BAYER_PAT_RGGB,
+    };
+    k_s32 ret = 0;
+    if (mirror.sensor_type != dev->sensor_mode_list[0].sensor_type ||
+        (k_u32)mirror.mirror > VICAP_MIRROR_BOTH)
+        return -EINVAL;
+    if (dev->init_flag)
+        ret = sc038hgs_update_bits(dev, 0x3221, 0x66, bits[mirror.mirror]);
+    if (!ret) {
+        dev->mirror_setting = mirror;
+        dev->current_sensor_mode.bayer_pattern =
+            dev->current_sensor_mode.ae_info.color_type == SENSOR_MONO ?
+            BAYER_PAT_BGGR : patterns[mirror.mirror];
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_init(void *ctx, k_sensor_mode requested)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u32 id, hts, vts;
+    k_s32 ret;
+    if (requested.sensor_type != dev->sensor_mode_list[0].sensor_type)
+        return -EINVAL;
+    ret = sc038hgs_power(dev, 1);
+    if (ret)
+        return ret;
+    dev->init_flag = K_FALSE;
+    dev->mode_init_flag = K_FALSE;
+    ret = sensor_reg_write(&dev->i2c_info, 0x2103, 1);
+    if (ret)
+        goto failed;
+    rt_thread_mdelay(20);
+    ret = sc038hgs_get_id(dev, &id);
+    for (k_u32 i = 0; !ret && i < sizeof(sc038hgs_default_fields) /
+                                      sizeof(sc038hgs_default_fields[0]); ++i)
+        ret = sc038hgs_update_bits(dev, sc038hgs_default_fields[i].addr,
+                                  sc038hgs_default_fields[i].mask,
+                                  sc038hgs_default_fields[i].value);
+    if (!ret)
+        ret = sensor_reg_list_write(&dev->i2c_info, sc038hgs_default_regs);
+    /* Check the selected interface as well as timing before allowing output. */
+    for (k_u32 i = 0; !ret && i < sizeof(sc038hgs_default_fields) /
+                                      sizeof(sc038hgs_default_fields[0]); ++i) {
+        k_u16 value;
+        ret = sensor_reg_read(&dev->i2c_info, sc038hgs_default_fields[i].addr, &value);
+        if (!ret && (value & sc038hgs_default_fields[i].mask) !=
+                    sc038hgs_default_fields[i].value)
+            ret = -EIO;
+    }
+    for (const k_sensor_reg *reg = sc038hgs_default_regs;
+         !ret && reg->addr != REG_NULL; ++reg) {
+        k_u16 value;
+        ret = sensor_reg_read(&dev->i2c_info, reg->addr, &value);
+        if (!ret && value != reg->val)
+            ret = -EIO;
+    }
+    if (!ret)
+        ret = sc038hgs_read16(dev, 0x320c, &hts);
+    if (!ret)
+        ret = sc038hgs_read16(dev, 0x320e, &vts);
+    if (ret)
+        goto failed;
+    if ((hts & 0xfff) != SC038HGS_HTS || vts != SC038HGS_VTS) {
+        ret = -EIO;
+        goto failed;
+    }
+    dev->current_sensor_mode = dev->sensor_mode_list[0];
+    dev->current_sensor_mode.ae_info = sc038hgs_ae_defaults;
+    dev->current_sensor_mode.et_line = 128;
+    sc038hgs_timing(dev, SC038HGS_HTS, SC038HGS_VTS);
+    dev->current_sensor_mode.ae_info.cur_integration_time =
+        128.0f * dev->current_sensor_mode.ae_info.one_line_exp_time;
+    dev->init_flag = K_TRUE;
+    ret = sc038hgs_mirror(dev, dev->mirror_setting);
+    if (ret)
+        goto failed;
+    dev->mode_init_flag = K_TRUE;
+    return 0;
+failed:
+    dev->init_flag = K_FALSE;
+    dev->mode_init_flag = K_FALSE;
+    (void)sc038hgs_update_bits(dev, 0x2100, 1, 0);
+    return ret;
+}
+
+static k_s32 sc038hgs_enum_mode(void *ctx, k_sensor_enum_mode *entry)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (!entry || entry->index >= dev->mode_count)
+        return -EINVAL;
+    entry->mode = dev->current_sensor_mode;
+    return 0;
+}
+
+static k_s32 sc038hgs_caps(void *ctx, k_sensor_caps *caps)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (!caps)
+        return -EINVAL;
+    memset(caps, 0, sizeof(*caps));
+    caps->bit_width = 10;
+    caps->mode = SENSOR_MODE_LINEAR;
+    caps->bayer_pattern = dev->current_sensor_mode.bayer_pattern;
+    caps->resolution.width = SC038HGS_WIDTH;
+    caps->resolution.height = SC038HGS_HEIGHT;
+    caps->mipi_lanes = 1;
+    return 0;
+}
+
+static k_s32 sc038hgs_connected(void *ctx, k_s32 *connected)
+{
+    k_u32 id;
+    k_s32 ret;
+    if (!connected)
+        return -EINVAL;
+    ret = sc038hgs_get_id(ctx, &id);
+    *connected = !ret;
+    return ret;
+}
+
+static k_s32 sc038hgs_stream(void *ctx, k_s32 enable)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (!dev->power_flag || (enable && !dev->init_flag))
+        return -EIO;
+    return sc038hgs_update_bits(dev, 0x2100, 1, !!enable);
+}
+
+static const struct { k_u8 code; float base; k_u8 max_fine; } sc038hgs_again[] = {
+    {0x00, 1.0f, 0x3f}, {0x01, 2.0f, 0x27}, {0x80, 2.5f, 0x3f},
+    {0x81, 5.0f, 0x3f}, {0x83, 10.0f, 0x3f}, {0x87, 20.0f, 0x3f},
+};
+
+static k_s32 sc038hgs_get_gain(void *ctx, k_sensor_gain *gain, k_bool digital)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u32 raw;
+    float value = 0.0f;
+    k_s32 ret;
+    if (!gain)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    ret = sc038hgs_read16(dev, digital ? 0x3e06 : 0x3e08, &raw);
+    if (ret)
+        return ret;
+    k_u8 coarse = raw >> 8, fine = raw & 0xff;
+    if (digital) {
+        if ((coarse != 0 && coarse != 1 && coarse != 3) ||
+            fine < 0x80 || fine > 0xfc || (fine & 3))
+            return -EIO;
+        value = (coarse + 1) * fine / 128.0f;
+        dev->current_sensor_mode.ae_info.cur_dgain = value;
+    } else {
+        for (k_u32 i = 0; i < sizeof(sc038hgs_again) / sizeof(sc038hgs_again[0]); ++i)
+            if (sc038hgs_again[i].code == coarse && fine >= 0x20 &&
+                fine <= sc038hgs_again[i].max_fine)
+                value = sc038hgs_again[i].base * fine / 32.0f;
+        if (!value)
+            return -EIO;
+        dev->current_sensor_mode.ae_info.cur_again = value;
+    }
+    memset(gain, 0, sizeof(*gain));
+    gain->gain[SENSOR_LINEAR_PARAS] = value;
+    dev->current_sensor_mode.ae_info.cur_gain =
+        dev->current_sensor_mode.ae_info.cur_again * dev->current_sensor_mode.ae_info.cur_dgain;
+    return 0;
+}
+
+static k_s32 sc038hgs_quantize_gain(float requested, k_bool digital,
+                                   k_sensor_reg regs[2], float *actual)
+{
+    if (!(requested > 0.0f) || requested > FLT_MAX)
+        return -EINVAL;
+    *actual = 1.0f;
+    regs[0] = (k_sensor_reg){digital ? 0x3e06 : 0x3e08, 0};
+    regs[1] = (k_sensor_reg){digital ? 0x3e07 : 0x3e09, digital ? 0x80 : 0x20};
+    /* Quantize down using only entries present in tables 2-7 / 2-8. */
+    for (k_u32 i = 0; i < (digital ? 3U : 6U); ++i) {
+        k_u8 coarse = digital ? ((1U << i) - 1U) : sc038hgs_again[i].code;
+        k_u32 limit = digital ? 63U : sc038hgs_again[i].max_fine;
+        float base = digital ? (float)(1U << i) : sc038hgs_again[i].base;
+        for (k_u32 fine = 32; fine <= limit; ++fine) {
+            float candidate = base * fine / 32.0f;
+            if (candidate <= requested && candidate >= *actual) {
+                *actual = candidate;
+                regs[0].val = coarse;
+                regs[1].val = digital ? fine * 4U : fine;
+            }
+        }
+    }
+    return 0;
+}
+
+static k_s32 sc038hgs_set_gain(void *ctx, k_sensor_gain gain, k_bool digital)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_sensor_reg regs[2];
+    float actual;
+    k_s32 ret;
+    if (!dev->init_flag)
+        return -EIO;
+    ret = sc038hgs_quantize_gain(gain.gain[SENSOR_LINEAR_PARAS], digital, regs, &actual);
+    if (ret)
+        return ret;
+    ret = sc038hgs_group_write(dev, regs, 2);
+    if (!ret) {
+        k_sensor_ae_info *ae = &dev->current_sensor_mode.ae_info;
+        if (digital)
+            ae->cur_dgain = actual;
+        else
+            ae->cur_again = actual;
+        ae->cur_gain = ae->cur_again * ae->cur_dgain;
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_get_again(void *ctx, k_sensor_gain *gain)
+{ return sc038hgs_get_gain(ctx, gain, K_FALSE); }
+static k_s32 sc038hgs_set_again(void *ctx, k_sensor_gain gain)
+{ return sc038hgs_set_gain(ctx, gain, K_FALSE); }
+static k_s32 sc038hgs_get_dgain(void *ctx, k_sensor_gain *gain)
+{ return sc038hgs_get_gain(ctx, gain, K_TRUE); }
+static k_s32 sc038hgs_set_dgain(void *ctx, k_sensor_gain gain)
+{ return sc038hgs_set_gain(ctx, gain, K_TRUE); }
+
+static k_s32 sc038hgs_read_exposure(struct sensor_driver_dev *dev, k_u32 *raw)
+{
+    k_u16 high;
+    k_s32 ret = sensor_reg_read(&dev->i2c_info, 0x3e00, &high);
+    if (!ret)
+        ret = sc038hgs_read16(dev, 0x3e01, raw);
+    if (!ret)
+        *raw |= (high & 0x0f) << 16;
+    return ret;
+}
+
+static k_s32 sc038hgs_get_exposure(void *ctx, k_sensor_intg_time *time)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u32 raw;
+    k_s32 ret;
+    if (!time)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        return -ENOSYS;
+    ret = sc038hgs_read_exposure(dev, &raw);
+    if (!ret) {
+        memset(time, 0, sizeof(*time));
+        time->intg_time[SENSOR_LINEAR_PARAS] = raw / 16.0f *
+            dev->current_sensor_mode.ae_info.one_line_exp_time;
+        dev->current_sensor_mode.ae_info.cur_integration_time = time->intg_time[0];
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_exposure_regs(struct sensor_driver_dev *dev, float seconds,
+                                   k_sensor_reg regs[3], k_u32 *raw)
+{
+    k_sensor_ae_info *ae = &dev->current_sensor_mode.ae_info;
+    k_u16 high;
+    k_s32 ret;
+    if (!dev->init_flag)
+        return -EIO;
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        return -ENOSYS;
+    if (!(seconds >= 0.0f) || seconds > FLT_MAX)
+        return -EINVAL;
+    if (seconds < ae->min_integraion_time)
+        seconds = ae->min_integraion_time;
+    if (seconds > ae->max_integraion_time)
+        seconds = ae->max_integraion_time;
+    *raw = (k_u32)(seconds / ae->one_line_exp_time * 16.0f + 0.5f);
+    if (*raw > (k_u32)ae->max_integraion_line * 16U)
+        *raw = ae->max_integraion_line * 16U;
+    ret = sensor_reg_read(&dev->i2c_info, 0x3e00, &high);
+    if (ret)
+        return ret;
+    regs[0] = (k_sensor_reg){0x3e00, (high & 0xf0) | ((*raw >> 16) & 0x0f)};
+    regs[1] = (k_sensor_reg){0x3e01, (*raw >> 8) & 0xff};
+    regs[2] = (k_sensor_reg){0x3e02, *raw & 0xff};
+    return 0;
+}
+
+static k_s32 sc038hgs_set_exposure(void *ctx, k_sensor_intg_time time)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_sensor_ae_info *ae = &dev->current_sensor_mode.ae_info;
+    k_sensor_reg regs[3];
+    k_u32 raw;
+    k_s32 ret = sc038hgs_exposure_regs(dev, time.intg_time[SENSOR_LINEAR_PARAS], regs, &raw);
+    if (ret)
+        return ret;
+    ret = sc038hgs_group_write(dev, regs, 3);
+    if (!ret) {
+        dev->current_sensor_mode.et_line = raw / 16U;
+        ae->cur_integration_time = raw / 16.0f * ae->one_line_exp_time;
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_get_exp_parm(void *ctx, k_sensor_exposure_param *param)
+{
+    k_sensor_intg_time time;
+    k_sensor_gain again, dgain;
+    k_s32 ret;
+    if (!param)
+        return -EINVAL;
+    ret = sc038hgs_get_exposure(ctx, &time);
+    if (!ret)
+        ret = sc038hgs_get_again(ctx, &again);
+    if (!ret)
+        ret = sc038hgs_get_dgain(ctx, &dgain);
+    if (!ret) {
+        memset(param, 0, sizeof(*param));
+        param->exp_time[0] = time.intg_time[0];
+        param->gain[0] = again.gain[0] * dgain.gain[0];
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_set_exp_parm(void *ctx, k_sensor_exposure_param param)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_sensor_ae_info *ae = &dev->current_sensor_mode.ae_info;
+    k_sensor_reg regs[7];
+    k_u32 raw;
+    float again, dgain;
+    k_s32 ret;
+    if (!dev->init_flag)
+        return -EIO;
+    /* Prefer analogue gain, then add digital gain (datasheet p. 23). */
+    ret = sc038hgs_quantize_gain(param.gain[0], K_FALSE, regs + 3, &again);
+    if (!ret)
+        ret = sc038hgs_quantize_gain(param.gain[0] / again, K_TRUE, regs + 5, &dgain);
+    if (!ret)
+        ret = sc038hgs_exposure_regs(dev, param.exp_time[0], regs, &raw);
+    if (ret)
+        return ret;
+    ret = sc038hgs_group_write(dev, regs, 7);
+    if (!ret) {
+        dev->current_sensor_mode.et_line = raw / 16U;
+        ae->cur_integration_time = raw / 16.0f * ae->one_line_exp_time;
+        ae->cur_again = again;
+        ae->cur_dgain = dgain;
+        ae->cur_gain = again * dgain;
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_get_fps(void *ctx, k_u32 *fps)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u32 hts, vts;
+    k_s32 ret;
+    if (!fps)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        return -ENOSYS;
+    ret = sc038hgs_read16(dev, 0x320c, &hts);
+    if (!ret)
+        ret = sc038hgs_read16(dev, 0x320e, &vts);
+    if (ret)
+        return ret;
+    hts &= 0xfff;
+    if (!hts || vts <= SC038HGS_EXP_MARGIN || vts > SC038HGS_MAX_VTS)
+        return -EIO;
+    sc038hgs_timing(dev, hts, vts);
+    *fps = dev->current_sensor_mode.fps; /* milli-fps, like mode.fps */
+    return 0;
+}
+
+static k_s32 sc038hgs_set_fps(void *ctx, k_u32 fps)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u32 hts, vts, exposure;
+    k_u16 high;
+    k_s32 ret;
+    if (!dev->init_flag)
+        return -EIO;
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        return -ENOSYS;
+    if (!fps || fps > 240000U)
+        return -EINVAL;
+    ret = sc038hgs_read16(dev, 0x320c, &hts);
+    if (ret)
+        return ret;
+    hts &= 0xfff;
+    if (!hts)
+        return -EIO;
+    k_u64 divisor = (k_u64)hts * fps;
+    k_u64 frame_lines = ((k_u64)CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ * 1000U + divisor - 1) / divisor;
+    if (frame_lines < SC038HGS_VTS || frame_lines > SC038HGS_MAX_VTS)
+        return -EINVAL;
+    vts = frame_lines;
+    ret = sc038hgs_read_exposure(dev, &exposure);
+    if (!ret)
+        ret = sensor_reg_read(&dev->i2c_info, 0x3e00, &high);
+    if (ret)
+        return ret;
+    if (exposure > (vts - SC038HGS_EXP_MARGIN) * 16U)
+        exposure = (vts - SC038HGS_EXP_MARGIN) * 16U;
+    k_sensor_reg regs[] = {
+        {0x320e, vts >> 8}, {0x320f, vts & 0xff},
+        {0x3e00, (high & 0xf0) | ((exposure >> 16) & 0xf)},
+        {0x3e01, (exposure >> 8) & 0xff}, {0x3e02, exposure & 0xff},
+    };
+    ret = sc038hgs_group_write(dev, regs, 5);
+    if (!ret) {
+        sc038hgs_timing(dev, hts, vts);
+        dev->current_sensor_mode.et_line = exposure / 16U;
+        dev->current_sensor_mode.ae_info.cur_integration_time = exposure / 16.0f *
+            dev->current_sensor_mode.ae_info.one_line_exp_time;
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_get_tpg(void *ctx, k_sensor_test_pattern *tpg)
+{
+    struct sensor_driver_dev *dev = ctx;
+    k_u16 value;
+    k_s32 ret;
+    if (!tpg)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    ret = sensor_reg_read(&dev->i2c_info, 0x4501, &value);
+    if (!ret) {
+        tpg->enable = !!(value & 8);
+        tpg->pattern = 0; /* The only documented pattern: grey gradient. */
+    }
+    return ret;
+}
+
+static k_s32 sc038hgs_set_tpg(void *ctx, k_sensor_test_pattern tpg)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (tpg.pattern || tpg.enable > 1)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    return sc038hgs_update_bits(dev, 0x4501, 8, tpg.enable ? 8 : 0);
+}
+
+static k_s32 sc038hgs_exposure_range(void *ctx, k_sensor_exposure_time_range *range)
+{
+    struct sensor_driver_dev *dev = ctx;
+    if (!range)
+        return -EINVAL;
+    if (!dev->init_flag)
+        return -EIO;
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        return -ENOSYS;
+    range->min_intg_time_us = dev->current_sensor_mode.ae_info.min_integraion_time * 1000000.0f;
+    range->max_intg_time_us = dev->current_sensor_mode.ae_info.max_integraion_time * 1000000.0f;
+    return 0;
+}
+
+static const k_sensor_function sc038hgs_functions = {
+    .sensor_power = sc038hgs_power,
+    .sensor_init = sc038hgs_init,
+    .sensor_get_chip_id = sc038hgs_get_id,
+    .sensor_get_mode = sc038hgs_get_mode,
+    .sensor_set_mode = sc038hgs_init,
+    .sensor_enum_mode = sc038hgs_enum_mode,
+    .sensor_get_caps = sc038hgs_caps,
+    .sensor_conn_check = sc038hgs_connected,
+    .sensor_set_stream = sc038hgs_stream,
+    .sensor_get_again = sc038hgs_get_again,
+    .sensor_set_again = sc038hgs_set_again,
+    .sensor_get_dgain = sc038hgs_get_dgain,
+    .sensor_set_dgain = sc038hgs_set_dgain,
+    .sensor_get_intg_time = sc038hgs_get_exposure,
+    .sensor_set_intg_time = sc038hgs_set_exposure,
+    .sensor_get_exp_parm = sc038hgs_get_exp_parm,
+    .sensor_set_exp_parm = sc038hgs_set_exp_parm,
+    .sensor_get_fps = sc038hgs_get_fps,
+    .sensor_set_fps = sc038hgs_set_fps,
+    .sensor_get_tpg = sc038hgs_get_tpg,
+    .sensor_set_tpg = sc038hgs_set_tpg,
+    .sensor_mirror_set = sc038hgs_mirror,
+    .sensor_get_exposure_time_range = sc038hgs_exposure_range,
+};
+
+k_s32 sensor_sc038hgs_probe(struct k_sensor_probe_cfg *cfg, struct sensor_driver_dev *dev)
+{
+    const k_sensor_mode *mode = NULL;
+    k_u32 id;
+    k_s32 ret;
+    for (k_u32 i = 0; i < sizeof(sc038hgs_modes) / sizeof(sc038hgs_modes[0]); ++i)
+        if (sc038hgs_modes[i].mipi_info.csi_id == cfg->csi_num)
+            mode = &sc038hgs_modes[i];
+    if (!mode)
+        return -EINVAL;
+    memset(dev, 0, sizeof(*dev));
+    dev->pwd_gpio = cfg->pwd_gpio;
+    dev->reset_gpio = cfg->reset_gpio;
+    dev->i2c_info.i2c_bus = rt_i2c_bus_device_find(cfg->i2c_name);
+    if (!dev->i2c_info.i2c_bus)
+        return -ENODEV;
+    snprintf(dev->i2c_info.i2c_name, sizeof(dev->i2c_info.i2c_name), "%s", cfg->i2c_name);
+    dev->i2c_info.reg_addr_size = SENSOR_REG_VALUE_16BIT;
+    dev->i2c_info.reg_val_size = SENSOR_REG_VALUE_8BIT;
+    /* External oscillator: do not enable, disable or retune SoC MCLKs. */
+    ret = sc038hgs_power(dev, 1);
+    if (ret)
+        goto failed;
+    for (k_u16 addr = 0x30; addr <= 0x33; ++addr) {
+        dev->i2c_info.slave_addr = addr;
+        ret = sc038hgs_get_id(dev, &id);
+        if (!ret)
+            break;
+    }
+    if (ret)
+        goto failed;
+    dev->sensor_mode_list = mode;
+    dev->mode_count = 1;
+    dev->current_sensor_mode = *mode;
+    dev->current_sensor_mode.ae_info = sc038hgs_ae_defaults;
+    sc038hgs_timing(dev, SC038HGS_HTS, SC038HGS_VTS);
+    dev->mirror_setting.sensor_type = mode->sensor_type;
+    dev->mirror_setting.mirror = VICAP_MIRROR_NONE;
+    dev->sensor_func = sc038hgs_functions;
+    snprintf(dev->sensor_name, sizeof(dev->sensor_name), "sc038hgs_csi%d", cfg->csi_num);
+    rt_kprintf("SC038HGS: id=0x%04x, %s addr=0x%02x, external 24 MHz\n",
+               id, cfg->i2c_name, dev->i2c_info.slave_addr);
+    if (!CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ)
+        rt_kprintf("SC038HGS: reset-default PLL; Pixel CLK unknown, fps/time controls unavailable\n");
+    return 0;
+failed:
+    (void)sc038hgs_power(dev, 0);
+    memset(dev, 0, sizeof(*dev));
+    return ret;
+}
diff --git a/kernel/sensor/src/sc038hgs/sensor_reg_table.c b/kernel/sensor/src/sc038hgs/sensor_reg_table.c
new file mode 100644
index 0000000..ca3fd40
--- /dev/null
+++ b/kernel/sensor/src/sc038hgs/sensor_reg_table.c
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * SC038HGS V1.1 documented reset-default mode, external 24 MHz, MIPI 1C1D.
+ * Page references refer to 3707708896SC038HGS_数据手册_V1.1.pdf.
+ * PLL/analogue settings are intentionally left at silicon reset values:
+ * their register addresses and divisors are not specified in this document.
+ * This is a bring-up sequence, not a vendor-qualified 240 fps mode table.
+ */
+static const k_sensor_reg sc038hgs_default_regs[] = {
+    /* Output window: 640 x 480, four border pixels/rows (p. 32). */
+    {0x3208, 0x02}, {0x3209, 0x80},
+    {0x320a, 0x01}, {0x320b, 0xe0},
+    {0x3210, 0x00}, {0x3211, 0x04},
+    {0x3212, 0x00}, {0x3213, 0x04},
+    /* Reset-default HTS=750 and VTS=600 (p. 33). */
+    {0x320d, 0xee}, {0x320e, 0x02}, {0x320f, 0x58},
+    /* Initial exposure: 128 lines in units of 1/16 line (p. 23). */
+    {0x3e01, 0x08}, {0x3e02, 0x00},
+    /* Unity analogue and digital gain (pp. 24, 27). */
+    {0x3e08, 0x00}, {0x3e09, 0x20},
+    {0x3e06, 0x00}, {0x3e07, 0x80},
+    {REG_NULL, 0x00},
+};
+
+static const struct {
+    k_u16 addr;
+    k_u8 mask;
+    k_u8 value;
+} sc038hgs_default_fields[] = {
+    {0x2100, 0x01, 0x00}, /* Sleep until explicit stream-on (p. 10). */
+    {0x3031, 0x1f, 0x0a}, /* MIPI RAW10 (p. 15). */
+    {0x3037, 0x60, 0x20}, /* PHY 10-bit (p. 15). */
+    {0x4b01, 0x08, 0x00}, /* Select MIPI rather than LVDS (p. 17). */
+    {0x4603, 0x01, 0x00}, /* Enable MIPI reader (p. 15). */
+    {0x3222, 0x01, 0x00}, /* Disable continuous external trigger (p. 20). */
+    {0x3225, 0x04, 0x00}, /* Disable single-frame trigger (p. 21). */
+    {0x3223, 0x88, 0x88}, /* Manual VTS; disable trigger exposure (p. 21). */
+    {0x3282, 0x08, 0x00}, /* Disable slave mode (p. 22). */
+    {0x3814, 0x40, 0x00}, /* Disable embedded lines (p. 30). */
+    {0x5989, 0x10, 0x00}, /* Disable embedded image overlay (p. 30). */
+    {0x320c, 0x0f, 0x02}, /* HTS high nibble (p. 33). */
+    {0x3e00, 0x0f, 0x00}, /* Exposure high nibble (p. 23). */
+    {0x4501, 0x08, 0x00}, /* Normal image, no test gradient (p. 33). */
+};
diff --git a/unit_test/mocks/sensor/lwp_user_mm.h b/unit_test/mocks/sensor/lwp_user_mm.h
new file mode 100644
index 0000000..d053ac1
--- /dev/null
+++ b/unit_test/mocks/sensor/lwp_user_mm.h
@@ -0,0 +1,3 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Driver tests do not cross the RT-Smart userspace boundary. Avoid importing
+ * RT-Smart's POSIX declarations into the host libc; no LWP function is used. */
diff --git a/unit_test/run_sc038hgs.py b/unit_test/run_sc038hgs.py
new file mode 100644
index 0000000..7207a63
--- /dev/null
+++ b/unit_test/run_sc038hgs.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Run the actual driver with simulated I2C/GPIO and the SDK's real ABI headers."""
+import os
+from itertools import product
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+mpp = Path(__file__).resolve().parents[1]
+sensor = mpp / 'kernel/sensor'
+command = ['make', '-nB', 'all', 'V=1']
+if os.environ.get('SDK_TOOLCHAIN_DIR'):
+    command.append('SDK_TOOLCHAIN_DIR=' + os.environ['SDK_TOOLCHAIN_DIR'])
+dry_run = subprocess.check_output(command, cwd=sensor, text=True)
+compile_line = next(line for line in dry_run.splitlines()
+                    if ' -c src/sc038hgs/sc038hgs.c ' in line)
+args = shlex.split(compile_line)[1:]
+flags = []
+it = iter(args)
+for arg in it:
+    if arg in ('-o', '-MF', '-c'):
+        next(it)
+    elif not (arg.startswith(('-march=', '-mabi=', '-mcmodel=')) or
+              arg in ('-MD', '-MP', '-fopenmp')):
+        flags.append(arg)
+
+with tempfile.TemporaryDirectory(prefix='sc038hgs-test-') as directory:
+    for clock, mono, csi in product((0, 108000000), (0, 1), (0, 1, 2)):
+        binary = str(Path(directory) / f'test-{clock}-{mono}-{csi}')
+        subprocess.run([os.environ.get('CC', 'cc'),
+                        '-I' + str(mpp / 'unit_test/mocks/sensor'), *flags,
+                        '-Werror', '-Wno-unused-variable',
+                        f'-DTEST_PIXEL_CLOCK={clock}',
+                        f'-DTEST_MONO={mono}', f'-DTEST_CSI={csi}',
+                        str(mpp / 'unit_test/tests/test_sc038hgs.c'),
+                        '-o', binary], cwd=sensor, check=True)
+        subprocess.run([binary], check=True)
diff --git a/unit_test/tests/test_sc038hgs.c b/unit_test/tests/test_sc038hgs.c
new file mode 100644
index 0000000..82760bd
--- /dev/null
+++ b/unit_test/tests/test_sc038hgs.c
@@ -0,0 +1,281 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "sensor_dev.h"
+#include <assert.h>
+#include <math.h>
+#include <stdarg.h>
+
+/* 108 MHz is a TEST FIXTURE, not a claim about the sensor's reset PLL. */
+#undef CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ
+#define CONFIG_MPP_SC038HGS_PIXEL_CLOCK_HZ TEST_PIXEL_CLOCK
+#undef CONFIG_MPP_ENABLE_CSI_DEV_0
+#undef CONFIG_MPP_ENABLE_CSI_DEV_1
+#undef CONFIG_MPP_ENABLE_CSI_DEV_2
+#define CONFIG_MPP_ENABLE_CSI_DEV_0 1
+#define CONFIG_MPP_ENABLE_CSI_DEV_1 1
+#define CONFIG_MPP_ENABLE_CSI_DEV_2 1
+#if !TEST_MONO
+#undef CONFIG_MPP_SC038HGS_MONO
+#endif
+#include "../../kernel/sensor/src/sc038hgs/sc038hgs.c"
+
+static k_u16 registers[65536];
+static k_sensor_reg pending[8];
+static unsigned pending_count;
+static int holding, pwdn, delay_ms, fail_addr = -1, fail_gpio = -1;
+static int ignore_addr = -1, fail_group_value = -1;
+static k_u16 address = 0x32;
+static struct rt_i2c_bus_device bus;
+
+rt_err_t kd_pin_mode(rt_base_t pin, rt_base_t mode)
+{ (void)mode; return pin == fail_gpio ? -EIO : 0; }
+rt_err_t kd_pin_write(rt_base_t pin, rt_base_t value)
+{
+    if (pin == fail_gpio)
+        return -EIO;
+    if (pin == 4) { pwdn = value; delay_ms = 0; }
+    return 0;
+}
+rt_err_t rt_thread_mdelay(rt_int32_t ms) { delay_ms += ms; return 0; }
+void rt_kprintf(const char *fmt, ...) { (void)fmt; }
+struct rt_i2c_bus_device *rt_i2c_bus_device_find(const char *name)
+{ return strcmp(name, "missing") ? &bus : NULL; }
+
+k_s32 sensor_reg_read(k_sensor_i2c_info *info, k_u16 reg, k_u16 *value)
+{
+    assert(pwdn && delay_ms >= 4);
+    if (info->slave_addr != address || reg == fail_addr)
+        return -EIO;
+    *value = registers[reg];
+    return 0;
+}
+k_s32 sensor_reg_write(k_sensor_i2c_info *info, k_u16 reg, k_u16 value)
+{
+    assert(pwdn && delay_ms >= 4);
+    assert(reg != 0x0100 && reg != 0x0103);
+    if (info->slave_addr != address || reg == fail_addr ||
+        (reg == 0x3800 && value == fail_group_value))
+        return -EIO;
+    if (reg == ignore_addr)
+        return 0;
+    if (reg == 0x2103) {
+        holding = 0;
+        pending_count = 0;
+    }
+    if (reg == 0x3800) {
+        if (value == 0) { holding = 1; pending_count = 0; }
+        if (value == 0x10) holding = 0;
+        if (value == 0x60)
+            for (unsigned i = 0; i < pending_count; ++i)
+                registers[pending[i].addr] = pending[i].val;
+    } else if (holding) {
+        assert(pending_count < 8);
+        pending[pending_count++] = (k_sensor_reg){reg, value};
+    } else {
+        registers[reg] = value;
+    }
+    return 0;
+}
+k_s32 sensor_reg_list_write(k_sensor_i2c_info *info, const k_sensor_reg *regs)
+{
+    for (; regs->addr != REG_NULL; ++regs) {
+        int ret = sensor_reg_write(info, regs->addr, regs->val);
+        if (ret) return ret;
+    }
+    return 0;
+}
+
+static void prepare(void)
+{
+    memset(registers, 0, sizeof(registers));
+    registers[0x3107] = 0x1a;
+    registers[0x3108] = 0x79;
+    registers[0x3031] = 0xe0;
+    registers[0x3037] = 0x9f;
+    registers[0x4b01] = 0x19; /* LVDS selected, other bits must survive. */
+    registers[0x3222] = 0xff;
+    registers[0x3225] = 0xff;
+    registers[0x3282] = 0xff;
+    registers[0x3e00] = 0xa0;
+    registers[0x4501] = 0xc5;
+    fail_addr = fail_gpio = -1;
+    ignore_addr = fail_group_value = -1;
+    holding = pending_count = pwdn = delay_ms = 0;
+}
+
+int main(void)
+{
+    struct sensor_driver_dev dev, other;
+    struct k_sensor_probe_cfg cfg = {TEST_CSI, "i2c1", 4, -1};
+    k_sensor_mode mode;
+    k_sensor_gain gain = {0}, got;
+    k_sensor_intg_time exposure = {0};
+    k_sensor_exposure_time_range range;
+    k_sensor_exposure_param param = {0}, got_param;
+    k_u32 fps, raw;
+    prepare();
+    assert(sensor_sc038hgs_probe(&cfg, &dev) == 0);
+    assert(dev.i2c_info.slave_addr == address && dev.mode_count == 1);
+    assert(!dev.init_flag);
+    assert(sc038hgs_stream(&dev, 1) != 0);
+    mode = dev.current_sensor_mode;
+    assert(sc038hgs_init(&dev, mode) == 0);
+    assert(registers[0x2100] == 0);
+    assert(registers[0x3031] == 0xea && registers[0x3037] == 0xbf);
+    assert(registers[0x4b01] == 0x11);
+    assert(dev.current_sensor_mode.mipi_info.csi_id == TEST_CSI);
+    assert(!(registers[0x3222] & 1) && !(registers[0x3225] & 4));
+    assert(!(registers[0x3282] & 8));
+    assert(registers[0x3e00] == 0xa0);
+    assert(sc038hgs_stream(&dev, 1) == 0 && registers[0x2100] == 1);
+    assert(sc038hgs_stream(&dev, 0) == 0 && registers[0x2100] == 0);
+
+    /* All documented analogue gain entries, including the 2x/2.5x boundary. */
+    for (unsigned i = 0; i < 6; ++i)
+        for (unsigned fine = 32; fine <= sc038hgs_again[i].max_fine; ++fine) {
+            gain.gain[0] = sc038hgs_again[i].base * fine / 32.0f;
+            assert(sc038hgs_set_again(&dev, gain) == 0);
+            assert(registers[0x3e08] == sc038hgs_again[i].code);
+            assert(registers[0x3e09] == fine);
+            assert(sc038hgs_get_again(&dev, &got) == 0);
+            assert(got.gain[0] == gain.gain[0]);
+        }
+    gain.gain[0] = 2.49f;
+    assert(sc038hgs_set_again(&dev, gain) == 0);
+    assert(registers[0x3e08] == 1 && registers[0x3e09] == 0x27);
+    for (unsigned i = 0; i < 3; ++i)
+        for (unsigned fine = 32; fine <= 63; ++fine) {
+            gain.gain[0] = (1U << i) * fine / 32.0f;
+            assert(sc038hgs_set_dgain(&dev, gain) == 0);
+            assert(registers[0x3e06] == (1U << i) - 1U);
+            assert(registers[0x3e07] == fine * 4);
+            assert(sc038hgs_get_dgain(&dev, &got) == 0 && got.gain[0] == gain.gain[0]);
+        }
+    gain.gain[0] = NAN;
+    assert(sc038hgs_set_again(&dev, gain) == -EINVAL);
+    gain.gain[0] = INFINITY;
+    assert(sc038hgs_set_dgain(&dev, gain) == -EINVAL);
+    gain.gain[0] = 1000;
+    assert(sc038hgs_set_again(&dev, gain) == 0);
+    assert(dev.current_sensor_mode.ae_info.cur_again == 39.375f);
+    assert(sc038hgs_set_tpg(&dev, (k_sensor_test_pattern){1, 0}) == 0);
+    assert(registers[0x4501] == 0xcd);
+    assert(sc038hgs_set_tpg(&dev, (k_sensor_test_pattern){0, 0}) == 0);
+    assert(registers[0x4501] == 0xc5);
+    k_sensor_enum_mode entry = {.index = 0};
+    assert(sc038hgs_enum_mode(&dev, &entry) == 0 && entry.mode.mipi_info.mipi_lanes == 1);
+    entry.index = 1;
+    assert(sc038hgs_enum_mode(&dev, &entry) == -EINVAL);
+    mode.sensor_type = SENSOR_TYPE_MAX;
+    assert(sc038hgs_init(&dev, mode) == -EINVAL && dev.init_flag);
+    mode = dev.current_sensor_mode;
+    assert(sc038hgs_mirror(&dev, (k_vicap_mirror_mode){mode.sensor_type, VICAP_MIRROR_BOTH}) == 0);
+    assert((registers[0x3221] & 0x66) == 0x66);
+    assert(dev.current_sensor_mode.bayer_pattern ==
+           (TEST_MONO ? BAYER_PAT_BGGR : BAYER_PAT_RGGB));
+
+#if TEST_PIXEL_CLOCK
+    assert(sc038hgs_exposure_range(&dev, &range) == 0 && range.min_intg_time_us > 0);
+    assert(sc038hgs_get_fps(&dev, &fps) == 0 && fps == 240000);
+    exposure.intg_time[0] = 128.5f * dev.current_sensor_mode.ae_info.one_line_exp_time;
+    assert(sc038hgs_set_exposure(&dev, exposure) == 0);
+    assert(sc038hgs_read_exposure(&dev, &raw) == 0 && raw == 2056);
+    assert(registers[0x3e00] == 0xa0);
+    exposure.intg_time[0] = 1.0f;
+    assert(sc038hgs_set_exposure(&dev, exposure) == 0);
+    assert(sc038hgs_read_exposure(&dev, &raw) == 0 && raw == 589U * 16U);
+    assert(sc038hgs_set_fps(&dev, 30000) == 0);
+    assert(dev.current_sensor_mode.ae_info.frame_length == 4800);
+    assert(sc038hgs_set_exposure(&dev, exposure) == 0);
+    assert(registers[0x3e00] == 0xa1); /* Exposure exceeds 4095 lines. */
+    assert(sc038hgs_set_fps(&dev, 240000) == 0);
+    assert(sc038hgs_read_exposure(&dev, &raw) == 0 && raw == 589U * 16U);
+    assert(sc038hgs_set_fps(&dev, 0) == -EINVAL);
+    assert(sc038hgs_set_fps(&dev, 1) == -EINVAL);
+    assert(sc038hgs_set_fps(&dev, 240001) == -EINVAL);
+    param.gain[0] = 39.375f * 7.875f;
+    param.exp_time[0] = 128.5f * dev.current_sensor_mode.ae_info.one_line_exp_time;
+    assert(sc038hgs_set_exp_parm(&dev, param) == 0 && pending_count == 7);
+    assert(sc038hgs_get_exp_parm(&dev, &got_param) == 0);
+    assert(got_param.gain[0] == param.gain[0]);
+    assert(fabsf(got_param.exp_time[0] - param.exp_time[0]) < 1e-7f);
+    param.gain[0] = 2.49f;
+    assert(sc038hgs_set_exp_parm(&dev, param) == 0);
+    assert(dev.current_sensor_mode.ae_info.cur_again == 2.4375f);
+    assert(dev.current_sensor_mode.ae_info.cur_dgain == 1.0f);
+    param.gain[0] = NAN;
+    assert(sc038hgs_set_exp_parm(&dev, param) == -EINVAL);
+    param.gain[0] = 1.0f;
+    param.exp_time[0] = INFINITY;
+    assert(sc038hgs_set_exp_parm(&dev, param) == -EINVAL);
+    /* The last gain register fails: neither exposure nor gain is launched. */
+    k_u32 old_exp;
+    assert(sc038hgs_read_exposure(&dev, &old_exp) == 0);
+    fail_addr = 0x3e07;
+    param.exp_time[0] = dev.current_sensor_mode.ae_info.min_integraion_time;
+    assert(sc038hgs_set_exp_parm(&dev, param) == -EIO && !dev.init_flag);
+    assert(sc038hgs_read_exposure(&dev, &raw) == 0 && raw == old_exp);
+    assert(registers[0x3e09] == 0x27);
+    fail_addr = -1;
+    assert(sc038hgs_init(&dev, mode) == 0);
+#else
+    assert(sc038hgs_exposure_range(&dev, &range) == -ENOSYS);
+    assert(dev.current_sensor_mode.fps == 0);
+    assert(sc038hgs_get_fps(&dev, &fps) == -ENOSYS);
+    assert(sc038hgs_set_fps(&dev, 30000) == -ENOSYS);
+    assert(sc038hgs_set_exposure(&dev, exposure) == -ENOSYS);
+    assert(sc038hgs_get_exposure(&dev, &exposure) == -ENOSYS);
+    param.gain[0] = 1.0f;
+    assert(sc038hgs_set_exp_parm(&dev, param) == -ENOSYS);
+    assert(sc038hgs_get_exp_parm(&dev, &got_param) == -ENOSYS);
+#endif
+    /* Failed group payload must not change hardware gain or cached gain. */
+    float before = dev.current_sensor_mode.ae_info.cur_again;
+    k_u16 before_coarse = registers[0x3e08], before_fine = registers[0x3e09];
+    fail_addr = 0x3e09;
+    gain.gain[0] = 1.0f;
+    assert(sc038hgs_set_again(&dev, gain) != 0);
+    assert(registers[0x3e08] == before_coarse && registers[0x3e09] == before_fine);
+    assert(dev.current_sensor_mode.ae_info.cur_again == before && !dev.init_flag);
+    assert(sc038hgs_stream(&dev, 1) != 0);
+    fail_addr = -1;
+    assert(sc038hgs_init(&dev, mode) == 0);
+    other = dev;
+    gain.gain[0] = 10.0f;
+    assert(sc038hgs_set_again(&dev, gain) == 0);
+    assert(other.current_sensor_mode.ae_info.cur_again == 1.0f &&
+           dev.current_sensor_mode.ae_info.cur_again == 10.0f);
+    assert(sc038hgs_power(&dev, 0) == 0 && !pwdn && !dev.init_flag);
+    assert(sc038hgs_get_id(&dev, &raw) != 0);
+    assert(sc038hgs_exposure_range(&dev, &range) == -EIO);
+
+    /* A sensor ACKs the write but retains LVDS: initialization must fail. */
+    prepare();
+    assert(sensor_sc038hgs_probe(&cfg, &dev) == 0);
+    ignore_addr = 0x4b01;
+    assert(sc038hgs_init(&dev, dev.current_sensor_mode) == -EIO);
+    assert(!dev.init_flag && !dev.mode_init_flag && !(registers[0x2100] & 1));
+    ignore_addr = -1;
+    for (unsigned i = 0; i < 3; ++i) {
+        assert(sc038hgs_init(&dev, dev.current_sensor_mode) == 0);
+        fail_group_value = (int[]){0x00, 0x10, 0x60}[i];
+        assert(sc038hgs_set_again(&dev, gain) == -EIO && !dev.init_flag);
+        assert(sc038hgs_stream(&dev, 1) == -EIO);
+        fail_group_value = -1;
+    }
+    assert(sc038hgs_power(&dev, 0) == 0);
+
+    for (address = 0x30; address <= 0x33; ++address) {
+        prepare();
+        assert(sensor_sc038hgs_probe(&cfg, &dev) == 0 && dev.i2c_info.slave_addr == address);
+        assert(sc038hgs_power(&dev, 0) == 0);
+    }
+    prepare();
+    registers[0x3108] = 0;
+    address = 0x30;
+    assert(sensor_sc038hgs_probe(&cfg, &dev) != 0 && !dev.sensor_func.sensor_init && !pwdn);
+    prepare();
+    fail_gpio = 4;
+    assert(sensor_sc038hgs_probe(&cfg, &dev) != 0);
+    printf("SC038HGS clock=%u mono=%d csi=%d: PASS\n", TEST_PIXEL_CLOCK, TEST_MONO, TEST_CSI);
+    return 0;
+}
